# ============================================================
# PlateMind Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Supabase (https://supabase.com → Project Settings → API)
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection (Project Settings → Database → URI)
# Use the "Session Mode" URI (port 5432) for synchronous libs,
# or the "Transaction Mode" URI (port 6543) for async/pooled connections.
# Add ?sslmode=require at the end for production.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------
# Groq API (https://console.groq.com → API Keys)
# Free tier: ~30 req/min, ~1,000 req/day — no credit card needed.
# ------------------------------------------------------------
GROQ_API_KEY=gsk_your-groq-api-key

# Model to use — options: llama-3.3-70b-versatile | llama-3.1-8b-instant
# 70b is recommended for quality; fall back to 8b if hitting rate limits.
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# App settings
# ------------------------------------------------------------
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins.
# Add your Vercel deployment URL here when deploying.
CORS_ORIGINS=http://localhost:3000
